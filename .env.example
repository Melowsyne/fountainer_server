# Copy to .env and adjust (docker-compose / run_server.py read these values).

# WebSocket protocol (v2.2)
FOUNTAIN_WS_HOST=0.0.0.0
FOUNTAIN_WS_PORT=8443

# Firmware HTTP (OTA download)
FOUNTAIN_HTTP_HOST=0.0.0.0
FOUNTAIN_HTTP_PORT=8080

# Publicly reachable address -> ends up in the OTA firmware URLs.
# For real devices this must be the server IP/DNS reachable from the device.
FOUNTAIN_PUBLIC_HOST=192.168.1.12
FOUNTAIN_PUBLIC_PORT=8080

# Paths
FOUNTAIN_DEVICES=devices.json
FOUNTAIN_FIRMWARE_DIR=FIRMWARE_UPDATES

# Mark OTA as mandatory (ota_available.mandatory=true)?  0/1
FOUNTAIN_OTA_MANDATORY=0

# Admin web interface (login + RPC buttons)
FOUNTAIN_WEB_ENABLED=1
FOUNTAIN_WEB_HOST=0.0.0.0
FOUNTAIN_WEB_PORT=8010
FOUNTAIN_ADMIN_USER=admin
FOUNTAIN_ADMIN_PASSWORD=admin

# Log level: DEBUG/INFO/WARNING
FOUNTAIN_LOG=INFO

# Offline watchdog: how long without device data until "offline".
# MUST be >= 150000 if the firmware uses the power-saving LOW mode
# (heartbeat/report are stretched to a 60 s grid there).
FOUNTAIN_HEARTBEAT_TIMEOUT_MS=150000

# TLS (wss:// + https firmware download). Certificates live in the testbed PKI
# under ../DO_NOT_COMMIT/CA (see PASSWORDS.md there; dummies ONLY, replace later).
# With TLS_CLIENT_CA a valid CLIENT certificate is enforced (mTLS) —
# the ESP32 authenticates with its device certificate.
# In the Docker setup docker-compose.yml already sets the TLS_* paths (PKI mount
# at /ca); the .env then only needs TLS_KEY_PASSWORD.
# (dummy testbed passphrase — use your own key's passphrase in production)
TLS_KEY_PASSWORD=server_password
# Additionally for run_server.py without Docker:
# TLS_CERT=../DO_NOT_COMMIT/CA/server/server.crt.pem
# TLS_KEY=../DO_NOT_COMMIT/CA/server/server.key.pem
# TLS_CLIENT_CA=../DO_NOT_COMMIT/CA/root/certs/ca.crt.pem
